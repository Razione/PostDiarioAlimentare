# Copia in .env.local e riempi con i valori del TUO progetto Firebase
# (Console Firebase → Impostazioni progetto → "I tuoi apps" → Config SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Team a cui appartengono i dati (uno solo per iniziare)
VITE_TEAM_ID=default
